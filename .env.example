# Copy to .env and adjust values before running docker compose

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=kamailio
DB_PASS=kamailio
DB_NAME=kamailio

# ── AMD Service ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
AMD_WORKERS=4

# ── FreeSWITCH (SignalWire) ───────────────────────────────────────────────────
# Free PAT from https://id.signalwire.com/personal_access_tokens
SIGNALWIRE_TOKEN=

# ── FreeSWITCH → AMD ──────────────────────────────────────────────────────────
# With network_mode: host, FreeSWITCH reaches AMD via 127.0.0.1
AMD_SERVICE_URL=http://127.0.0.1:8080
